# Archivos que git no debe guardar.

# Secretos y configuración local: solo se versiona .env.example.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Respaldos de la base de datos (`make db-dump`): pesados y con datos.
backups/

# Reportes en PDF que arman las corridas automáticas (F12.8): datos, no código.
data/reportes/

# Geodatos pesados: se descargan y generan con `make geo-load`.
geodata/raw/
geodata/output/

# Editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
# Compilaciones temporales de la actualización automática en la VM (scripts/servidor/actualizar.sh).
frontend/dist.nuevo/
frontend/dist.viejo/
