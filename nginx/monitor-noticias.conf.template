# Sitio de nginx del monitor de noticias (WSL o el servidor de Proxmox).
#
# Es una plantilla: `make up` reemplaza __PROJECT_ROOT__ por la ruta real del
# proyecto, __LISTEN__ por las direcciones de NGINX_LISTEN (en WSL, solo
# 127.0.0.1:8080) y __SENDFILE__ por NGINX_SENDFILE (en WSL, off), y la
# instala en /etc/nginx/sites-available/monitor-noticias.
#
# Qué hace: sirve el frontend compilado (frontend/dist), reenvía /api a la API
# (uvicorn en el puerto 8000) y sirve los PMTiles de geodata/output con
# soporte de peticiones Range (ADR-0004). Agrega encabezados de seguridad.
# Qué NO hace: no termina HTTPS; eso se define en el despliegue (F8).

server {
    # En WSL solo localhost: WSL2 lo reenvía a Windows y no queda expuesto a la
    # red. En el servidor, también sus redes (docs/migracion-proxmox.md).
    __LISTEN__
    server_name localhost;

    root __PROJECT_ROOT__/frontend/dist;
    index index.html;

    # En WSL los archivos viven en D: (montado en /mnt/d) y sendfile sobre ese
    # montaje puede entregar respuestas vacías o corruptas: ahí va apagado. En
    # el servidor (NGINX_SENDFILE=on) los archivos están en su propio disco y
    # sendfile los manda sin copiarlos por la memoria de nginx.
    sendfile __SENDFILE__;

    # Comprimir lo que es texto. El JavaScript de la pantalla pesa 2.1 MB y
    # viajaba sin comprimir (nginx.conf solo comprime HTML): por ZeroTier
    # tardaba varios segundos (medido el 07/11/2026). Nivel 5: casi lo mismo
    # que el máximo con mucho menos CPU. Los PMTiles no se comprimen: ya vienen
    # comprimidos y el mapa los pide por pedazos (Range).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css text/javascript application/javascript application/json
               image/svg+xml text/plain application/geo+json;

    include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        # $http_host conserva el puerto (:8080): la API compara el Origin del
        # navegador con este Host para frenar peticiones de otros sitios (CSRF).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Las búsquedas son asíncronas (202 + consulta de estado): ninguna
        # petición debería tardar más que esto.
        proxy_read_timeout 60s;
    }

    location /tiles/ {
        alias __PROJECT_ROOT__/geodata/output/;
        # nginx atiende Range en archivos estáticos por sí solo; PMTiles lo
        # necesita para leer solo los bytes de cada tesela.
        # Un bloque `types` aquí reemplaza toda la tabla de tipos, así que se
        # declaran todos los que se sirven en /tiles/: PMTiles y los recursos
        # del mapa base (sprite en JSON y PNG, fuentes en PBF).
        types {
            application/vnd.pmtiles pmtiles;
            application/json json;
            image/png png;
            application/x-protobuf pbf;
            text/plain txt;
        }
        default_type application/octet-stream;
        # add_header en un location anula los del server: se vuelven a incluir.
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location /assets/ {
        # Vite pone un hash en el nombre de estos archivos: se pueden guardar
        # en caché para siempre porque cambian de nombre al cambiar.
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        # El worker de MapLibre v6 es un módulo .mjs, y la tabla de tipos de
        # nginx no conoce esa extensión: lo enviaba como octet-stream y el
        # navegador lo rechazaba ("non-JavaScript MIME type").
        location ~ \.mjs$ {
            types { }
            default_type text/javascript;
            include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
    }

    location = /index.html {
        # Sin caché: así el navegador siempre ve qué archivos con hash cargar
        # tras una actualización, en lugar de seguir con la versión vieja.
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        # Aplicación de una sola página: cualquier ruta desconocida carga
        # index.html y React decide qué mostrar.
        try_files $uri $uri/ /index.html;
    }
}
