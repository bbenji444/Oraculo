# Sitio de nginx del monitor de noticias (WSL o el servidor de Proxmox).
#
# Es una plantilla: `make up` reemplaza __PROJECT_ROOT__ por la ruta real del
# proyecto, __LISTEN__ por las direcciones de NGINX_LISTEN (en WSL, solo
# 127.0.0.1:8080), __SENDFILE__ por NGINX_SENDFILE (en WSL, off) y las marcas
# __GATEWAY_*__ por lo que digan ORACULO_GATEWAY_IPS y GATEWAY_ONLY, y la
# instala en /etc/nginx/sites-available/monitor-noticias.
#
# Qué hace: sirve el frontend compilado (frontend/dist), reenvía /api a la API
# (uvicorn en el puerto 8000) y sirve los PMTiles de geodata/output con
# soporte de peticiones Range (ADR-0004). Agrega encabezados de seguridad.
# Detrás del gateway de Oráculo (ADR-0119) confía solo en sus IP: de ahí toma
# la IP real del analista y los encabezados X-Oraculo-*, y con GATEWAY_ONLY=si
# no deja entrar a nadie más.
# Qué NO hace: no termina HTTPS; eso se define en el despliegue (F8).

# --- Gateway de Oráculo (ADR-0119) ---------------------------------------------
# $realip_remote_addr es quien abrió la conexión, antes de que real_ip la
# cambie por la IP del analista: así se sabe si la petición viene del gateway.
geo $realip_remote_addr $monitor_from_gateway {
    default 0;
__GATEWAY_GEO__
}

# Quién puede entrar con GATEWAY_ONLY=si: el gateway y la propia máquina
# (make status y la espera de make up preguntan por 127.0.0.1).
geo $realip_remote_addr $monitor_trusted_peer {
    default 0;
    127.0.0.1 1;
    ::1 1;
__GATEWAY_GEO__
}

# 1 = se rechaza. Solo pasa con GATEWAY_ONLY=si y alguien que no es de confianza.
map "__GATEWAY_ONLY__:$monitor_trusted_peer" $monitor_gateway_block {
    "si:0" 1;
    default 0;
}

# Los encabezados de Oráculo solo valen si los manda el gateway: si vienen de
# otro lado se borran (un valor vacío hace que nginx no los reenvíe). Son
# datos para la bitácora; la identidad sale siempre de la llave Bearer.
map $monitor_from_gateway $monitor_oraculo_user {
    1 $http_x_oraculo_user;
    default "";
}
map $monitor_from_gateway $monitor_oraculo_user_id {
    1 $http_x_oraculo_user_id;
    default "";
}
map $monitor_from_gateway $monitor_oraculo_module {
    1 $http_x_oraculo_module;
    default "";
}

server {
    # En WSL solo localhost: WSL2 lo reenvía a Windows y no queda expuesto a la
    # red. En el servidor, también sus redes (docs/migracion-proxmox.md).
    __LISTEN__
    server_name localhost;

    root __PROJECT_ROOT__/frontend/dist;
    index index.html;

    # En WSL los archivos viven en D: (montado en /mnt/d) y sendfile sobre ese
    # montaje puede entregar respuestas vacías o corruptas: ahí va apagado. En
    # el servidor (NGINX_SENDFILE=on) los archivos están en su propio disco y
    # sendfile los manda sin copiarlos por la memoria de nginx.
    sendfile __SENDFILE__;

    # Detrás del gateway todos llegan con la IP de Oráculo: sin esto, la
    # bitácora y el bloqueo por intentos fallidos verían a una sola persona y
    # diez llaves malas de cualquiera bloquearían a todos. Solo se cree el
    # X-Forwarded-For que mande el gateway; sin ORACULO_GATEWAY_IPS no aplica.
__GATEWAY_REAL_IP__
    if ($monitor_gateway_block) {
        return 403;
    }

    # Comprimir lo que es texto. El JavaScript de la pantalla pesa 2.1 MB y
    # viajaba sin comprimir (nginx.conf solo comprime HTML): por ZeroTier
    # tardaba varios segundos (medido el 07/11/2026). Nivel 5: casi lo mismo
    # que el máximo con mucho menos CPU. Los PMTiles no se comprimen: ya vienen
    # comprimidos y el mapa los pide por pedazos (Range).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css text/javascript application/javascript application/json
               image/svg+xml text/plain application/geo+json;

    include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;

    # El monitor también vive en /noticias/ (ADR-0122). El gateway de Oráculo
    # sirve cada módulo bajo su propia ruta, con la misma ruta en el módulo
    # (OSINT en /osint/…): reenvía /noticias/… sin quitar el prefijo. Aquí se
    # quita y se vuelve a buscar el location, así /noticias/api/v1/… recibe lo
    # mismo que /api/v1/… (tiempos de 240 s incluidos) y /noticias/tiles/… lo
    # mismo que /tiles/… (Range). La pantalla pide todo con rutas relativas,
    # así que sirve igual en la raíz y aquí.
    location = /noticias {
        # Relativa: así no lleva el host ni el puerto de la VM, que el
        # navegador no debe ver.
        absolute_redirect off;
        return 301 /noticias/;
    }
    location ^~ /noticias/ {
        rewrite ^/noticias/(.*)$ /$1 last;
    }

    location /api/ {
        include __PROJECT_ROOT__/nginx/proxy-api.conf;
        # Las búsquedas son asíncronas (202 + consulta de estado): ninguna
        # petición debería tardar más que esto.
        proxy_read_timeout 60s;
    }

    # Las rutas que esperan a la IA o a un proveedor dentro de la petición: el
    # reporte (la primera vez escribe el resumen ejecutivo), las sugerencias de
    # términos y los envíos de prueba o reintento. La IA tiene 60 s por intento
    # y reintenta; 240 s es lo mismo que pide OSINT al gateway (ADR-0119).
    location ~ ^/api/v1/(searches/[^/]+/report|concepts/suggest|deliveries/test|deliveries/history/[^/]+/retry)$ {
        include __PROJECT_ROOT__/nginx/proxy-api.conf;
        proxy_read_timeout 240s;
    }

    # La vista del reporte en pantalla se incrusta en el monitor: su política
    # de contenido y X-Frame-Options los pone la API (ADR-0111).
    location ~ ^/api/v1/searches/[^/]+/report/view$ {
        include __PROJECT_ROOT__/nginx/proxy-api.conf;
        # La primera vez se escribe el resumen ejecutivo con la IA.
        proxy_read_timeout 240s;
        include __PROJECT_ROOT__/nginx/encabezados-reporte.conf;
    }

    location /tiles/ {
        alias __PROJECT_ROOT__/geodata/output/;
        # nginx atiende Range en archivos estáticos por sí solo; PMTiles lo
        # necesita para leer solo los bytes de cada tesela.
        # Un bloque `types` aquí reemplaza toda la tabla de tipos, así que se
        # declaran todos los que se sirven en /tiles/: PMTiles y los recursos
        # del mapa base (sprite en JSON y PNG, fuentes en PBF).
        types {
            application/vnd.pmtiles pmtiles;
            application/json json;
            image/png png;
            application/x-protobuf pbf;
            text/plain txt;
        }
        default_type application/octet-stream;
        # add_header en un location anula los del server: se vuelven a incluir.
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location /assets/ {
        # Vite pone un hash en el nombre de estos archivos: se pueden guardar
        # en caché para siempre porque cambian de nombre al cambiar.
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        # El worker de MapLibre v6 es un módulo .mjs, y la tabla de tipos de
        # nginx no conoce esa extensión: lo enviaba como octet-stream y el
        # navegador lo rechazaba ("non-JavaScript MIME type").
        location ~ \.mjs$ {
            types { }
            default_type text/javascript;
            include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
    }

    location = /index.html {
        # Sin caché: así el navegador siempre ve qué archivos con hash cargar
        # tras una actualización. no-store además evita que «atrás» muestre
        # la pantalla de memoria después de salir de Oráculo (ADR-0123).
        include __PROJECT_ROOT__/nginx/encabezados-seguridad.conf;
        add_header Cache-Control "no-store" always;
    }

    location / {
        # Aplicación de una sola página: cualquier ruta desconocida carga
        # index.html y React decide qué mostrar.
        try_files $uri $uri/ /index.html;
    }
}
