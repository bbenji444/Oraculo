# Variables de entorno del proyecto monitor-noticias.
#
# Cómo se usa: `make bootstrap` copia este archivo a `.env` si no existe.
# `.env` está en .gitignore: ahí van los valores reales y los secretos.
# Nunca pongas una llave real en este archivo de ejemplo.
#
# Los valores de abajo sirven tal cual para desarrollo local en WSL.

# --- Aplicación ---------------------------------------------------------------

# Entorno de ejecución: "development", "test" o "production".
APP_ENV=development
# Nivel de detalle de los logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS -----------------------------------------------------

# Servidor de base de datos. En desarrollo, PostgreSQL 16 dentro de WSL.
POSTGRES_HOST=localhost
# Puerto del clúster PostgreSQL 16.
POSTGRES_PORT=5432
# Usuario de la aplicación. `make bootstrap` lo crea si no existe.
POSTGRES_USER=monitor
# Contraseña del usuario de la aplicación. Cámbiala en tu .env.
POSTGRES_PASSWORD=monitor_dev
# Base de datos de desarrollo.
POSTGRES_DB=monitor_noticias
# Base de datos exclusiva para pruebas de integración: se puede vaciar sin miedo.
POSTGRES_TEST_DB=monitor_noticias_test

# --- Redis --------------------------------------------------------------------

# Redis: cola de tareas de Celery (base 0) y caché.
REDIS_URL=redis://localhost:6379/0
# Redis para pruebas de integración: otra base (15) para no mezclarse con el
# worker de desarrollo ni borrar su caché.
REDIS_TEST_URL=redis://localhost:6379/15

# --- Diagnóstico --------------------------------------------------------------

# Segundos máximos que /health espera a cada componente antes de marcarlo con error.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Auditoría ----------------------------------------------------------------

# Usuario que firma los cambios en la bitácora (audit_log) mientras no haya
# autenticación (llega en F8). Opcional: si no se define, "desarrollo".
# DEV_USER=desarrollo

# --- Proveedores de noticias (F3) -----------------------------------------------

# Llave de SearchApi (https://www.searchapi.io, cuenta propia). Solo vive aquí,
# nunca en el código ni en el frontend. Sin ella, SearchApi se salta con aviso.
# SEARCHAPI_API_KEY=
# Segundos máximos por petición (SearchApi tiene su propio límite, más alto).
# PROVIDER_TIMEOUT_SECONDS=20
# SEARCHAPI_TIMEOUT_SECONDS=30
# Intentos por petición (reintentos solo ante 429, 5xx o red caída).
# PROVIDER_MAX_ATTEMPTS=3
# Peticiones simultáneas por proveedor.
# PROVIDER_MAX_CONCURRENCY=2
# GDELT: desactivado por defecto porque respondió 429 de forma persistente
# (docs/adr/0012). No lo actives a mano: `make gdelt-diagnostico` dice cuándo
# hay evidencia para proponerlo.
# GDELT_ENABLED=false
# Pausa mínima entre peticiones a GDELT, y espera mínima antes de reintentar
# cuando responde 429 ("ve más despacio"), en segundos.
# GDELT_MIN_INTERVAL_SECONDS=5
# GDELT_RATE_LIMIT_WAIT_SECONDS=15
# Máximo de consultas por búsqueda y horas que dura la caché de consultas.
# MAX_QUERIES_PER_SEARCH=10
# QUERY_CACHE_TTL_HOURS=6
# Tope de créditos de SearchApi por mes calendario (0 = no usar SearchApi).
# SEARCHAPI_MONTHLY_CREDIT_LIMIT=100
# ⚠️ Google News RSS: sus términos solo permiten uso personal y no comercial
# (docs/adr/0011). Desactivado por defecto. Solo para desarrollo, NUNCA en
# producción mientras la revisión legal no diga lo contrario.
# NEWS_RSS_ENABLED=false

# --- Ingesta al índice local (docs/adr/0013) ----------------------------------

# Archivos GKG de GDELT cada 15 minutos (servidor de archivos, sin el límite de
# la API). Unos 760 MB de descarga al día mientras `make up` corre.
# GDELT_GKG_ENABLED=true
# RSS directos de medios mexicanos. Apagados hasta revisar los términos de uso
# de cada medio; además cada medio se activa en fuentes/medios_rss.csv.
# MEDIA_RSS_ENABLED=false
# Días que se conservan las notas del índice local.
# NEWS_INDEX_RETENTION_DAYS=90
# Minutos entre corridas de la ingesta (celery beat).
# INGEST_INTERVAL_MINUTES=15
# Ngramas de GDELT: frases del texto completo de cada nota, para buscar en el
# cuerpo (docs/adr/0014). ~1 GB de descarga al día. Apagados hasta revisar
# `make ngramas-muestra`.
# GDELT_NGRAMS_ENABLED=false
# Días que se conservan las frases del cuerpo (la nota sigue hasta
# NEWS_INDEX_RETENTION_DAYS). Son lo que más ocupa en disco.
# NEWS_BODY_RETENTION_DAYS=30
# Minutos hacia atrás que revisa cada corrida de ngramas, y minutos recientes
# que deja para la siguiente (GDELT publica cada minuto, en tandas).
# NGRAMS_LOOKBACK_MINUTES=35
# NGRAMS_DELAY_MINUTES=3

# --- Geodatos -----------------------------------------------------------------

# Carpeta de trabajo del pipeline de geodatos (capas extraídas, PMTiles en
# construcción). Debe estar en el disco de Linux, no en /mnt/...: GDAL recibió
# bytes dañados al leer directamente del disco de Windows (ADR-0008).
# Opcional: si no se define, se usa ~/.cache/monitor-noticias/geodata del
# usuario de Ubuntu que corre el comando.
# GEODATA_WORK_DIR=/ruta/en/linux
