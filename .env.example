# Variables de entorno del proyecto monitor-noticias.
#
# Cómo se usa: `make bootstrap` copia este archivo a `.env` si no existe.
# `.env` está en .gitignore: ahí van los valores reales y los secretos.
# Nunca pongas una llave real en este archivo de ejemplo.
#
# Los valores de abajo sirven tal cual para desarrollo local en WSL.

# --- Aplicación ---------------------------------------------------------------

# Entorno de ejecución: "development", "test" o "production".
APP_ENV=development
# Nivel de detalle de los logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS -----------------------------------------------------

# Servidor de base de datos. En desarrollo, PostgreSQL 16 dentro de WSL.
POSTGRES_HOST=localhost
# Puerto del clúster PostgreSQL 16.
POSTGRES_PORT=5432
# Usuario de la aplicación. `make bootstrap` lo crea si no existe.
POSTGRES_USER=monitor
# Contraseña del usuario de la aplicación. Cámbiala en tu .env.
POSTGRES_PASSWORD=monitor_dev
# Base de datos de desarrollo.
POSTGRES_DB=monitor_noticias
# Base de datos exclusiva para pruebas de integración: se puede vaciar sin miedo.
POSTGRES_TEST_DB=monitor_noticias_test

# --- Redis --------------------------------------------------------------------

# Redis: cola de tareas de Celery (base 0) y caché.
REDIS_URL=redis://localhost:6379/0
# Redis para pruebas de integración: otra base (15) para no mezclarse con el
# worker de desarrollo ni borrar su caché.
REDIS_TEST_URL=redis://localhost:6379/15

# --- Diagnóstico --------------------------------------------------------------

# Segundos máximos que /health espera a cada componente antes de marcarlo con error.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Auditoría ----------------------------------------------------------------

# Usuario que firma los cambios en la bitácora (audit_log) mientras no haya
# autenticación (llega en F8). Opcional: si no se define, "desarrollo".
# DEV_USER=desarrollo

# --- Proveedores de noticias (F3) -----------------------------------------------

# Llave de SearchApi (https://www.searchapi.io, cuenta propia). Solo vive aquí,
# nunca en el código ni en el frontend. Sin ella, SearchApi se salta con aviso.
# SEARCHAPI_API_KEY=
# Segundos máximos por petición (SearchApi tiene su propio límite, más alto).
# PROVIDER_TIMEOUT_SECONDS=20
# SEARCHAPI_TIMEOUT_SECONDS=30
# Intentos por petición (reintentos solo ante 429, 5xx o red caída).
# PROVIDER_MAX_ATTEMPTS=3
# Peticiones simultáneas por proveedor.
# PROVIDER_MAX_CONCURRENCY=2
# GDELT: desactivado por defecto porque respondió 429 de forma persistente
# (docs/adr/0012). No lo actives a mano: `make gdelt-diagnostico` dice cuándo
# hay evidencia para proponerlo.
# GDELT_ENABLED=false
# Pausa mínima entre peticiones a GDELT, y espera mínima antes de reintentar
# cuando responde 429 ("ve más despacio"), en segundos.
# GDELT_MIN_INTERVAL_SECONDS=5
# GDELT_RATE_LIMIT_WAIT_SECONDS=15
# Máximo de consultas por búsqueda y horas que dura la caché de consultas.
# MAX_QUERIES_PER_SEARCH=10
# QUERY_CACHE_TTL_HOURS=6
# Máximo de entidades que se dibujan en el muro de un caso (Fase 9.6); las
# demás se cuentan como «+N más».
# CASE_MAX_VISIBLE_NODES=150
# Tope de créditos de SearchApi por mes calendario (0 = no usar SearchApi).
# SEARCHAPI_MONTHLY_CREDIT_LIMIT=100
# Páginas de Google News por consulta (10 notas y 1 crédito cada una). Se pide
# la siguiente solo si la anterior vino llena; la estimación muestra el máximo.
# SEARCHAPI_MAX_PAGES=3
# Google News RSS (gratis): activado por defecto, también en producción, por
# dictamen de la Dirección del 24/10/2026 (docs/adr/0021, sustituye al 0011).
# Ponlo en false solo para apagarlo (por ejemplo, si Google lo bloquea).
# NEWS_RSS_ENABLED=true
# Fuentes encendidas por defecto en los switches de la búsqueda manual (F12.2,
# docs/adr/0027), separadas por comas: google_news_rss, indice_local, searchapi.
# El analista las enciende o apaga en cada búsqueda. SearchApi va apagado por
# defecto: casi todo lo que trae ya lo da el RSS gratis (medición del 25/10/2026).
# MANUAL_DEFAULT_SOURCES=google_news_rss,indice_local

# --- Monitor automático FGR (docs/adr/0031) ----------------------------------
# Una búsqueda nacional de la FGR a las 07:00, 15:00 y 23:00 (hora de la CDMX),
# solo con fuentes gratis. Cada corrida queda en el historial de todos y deja
# su reporte en PDF en REPORTS_DIR. false las apaga sin tocar código.
# AUTOMATIC_RUNS_ENABLED=true
# Horas de la CDMX separadas por coma.
# AUTOMATIC_RUN_HOURS=7,15,23
# Concepto que se busca (el que crea make seed) y región (MEX = todo México).
# AUTOMATIC_CONCEPT=Fiscalia General de la Republica
# AUTOMATIC_REGION_CODE=MEX
# Fuentes de las corridas: siempre las mismas, para comparar una con otra.
# AUTOMATIC_SOURCES=google_news_rss,indice_local
# Cada corrida cubre solo lo publicado desde la corrida programada anterior
# (23:00 a 07:00, 07:00 a 15:00 y 15:00 a 23:00), aunque la anterior falle.
# Minutos extra antes del inicio de cada ventana, para notas que los
# buscadores muestran tarde. 0 = estricto (lo que pidió Benji).
# AUTOMATIC_WINDOW_MARGIN_MINUTES=0
# Firma de las corridas en la bitácora.
# AUTOMATIC_USER=monitor-automatico
# Notas nuevas que la IA lee por corrida automática (las manuales usan
# LLM_MAX_ARTICLES_PER_SEARCH). Cada nota cuesta ~0.00024 USD.
# AUTOMATIC_LLM_MAX_ARTICLES=250
# Carpeta de los PDF (por defecto data/reportes en la carpeta del proyecto).
# REPORTS_DIR=/ruta/a/reportes

# --- Envíos (docs/adr/0039) --------------------------------------------------
# Manda el reporte de cada corrida por correo (y más adelante WhatsApp) según
# las reglas de la pantalla «Envíos». Las cuentas de correo se conectan con
# Composio (https://composio.dev).
# Llave del PROYECTO de Composio (Platform › proyecto › Settings › API Keys):
# empieza con ak_. No sirven la ck_ (asistentes) ni la oak_ (organización).
# Para conectar cuentas desde la pantalla necesita permiso de escritura en
# «auth_configs» y «connected_accounts».
# COMPOSIO_API_KEY=
# Dueño de las cuentas en Composio (el monitor).
# COMPOSIO_USER_ID=oraculo-monitor
# Interruptor general: false = las corridas automáticas no mandan nada (la
# prueba manual sí). Se prende cuando las reglas estén revisadas.
# DELIVERIES_ENABLED=false

# --- BrowserWork (docs/adr/0028) ----------------------------------------------

# Servicio del jefe de Benji que busca en Bing y en Google 2 con un Chrome real.
# Solo la dirección de su API: no lleva llave ni usuario. Vacía = no se ofrece.
# BROWSERWORK_BASE_URL=http://192.168.0.37:8787
# Páginas por motor (1 a 10; ~10 notas cada una). Su navegador atiende una
# búsqueda a la vez para todos, así que se pide poco.
# BROWSERWORK_PAGES=1
# Tope de espera por búsqueda (menor que los 600 s que espera un captcha) y
# cada cuánto se pregunta si ya terminó.
# BROWSERWORK_TIMEOUT_SECONDS=240
# BROWSERWORK_POLL_SECONDS=3

# --- Ingesta al índice local (docs/adr/0013) ----------------------------------

# Archivos GKG de GDELT cada 15 minutos (solo títulos). Apagados por defecto: los
# reemplazan los ngramas (docs/adr/0014). Unos 760 MB de descarga al día si se encienden.
# GDELT_GKG_ENABLED=false
# RSS directos de medios mexicanos. Encendidos por defecto (decisión de Benji,
# 16/10/2026); cada medio se activa o apaga en fuentes/medios_rss.csv.
# MEDIA_RSS_ENABLED=true
# Días que se conservan las notas del índice local.
# NEWS_INDEX_RETENTION_DAYS=90
# Minutos entre corridas de la ingesta (celery beat).
# INGEST_INTERVAL_MINUTES=15
# Ngramas de GDELT: frases del texto completo de cada nota, para buscar en el
# cuerpo (docs/adr/0014). ~1 GB de descarga al día. Encendidos por defecto.
# `make ngramas-muestra` prueba una hora real.
# GDELT_NGRAMS_ENABLED=true
# Días que se conservan las frases del cuerpo (la nota sigue hasta
# NEWS_INDEX_RETENTION_DAYS). Son lo que más ocupa en disco.
# NEWS_BODY_RETENTION_DAYS=30
# Minutos hacia atrás que revisa cada corrida de ngramas, y minutos recientes
# que deja para la siguiente (GDELT publica cada minuto, en tandas).
# NGRAMS_LOOKBACK_MINUTES=35
# NGRAMS_DELAY_MINUTES=3

# --- Geodatos -----------------------------------------------------------------

# Carpeta de trabajo del pipeline de geodatos (capas extraídas, PMTiles en
# construcción). Debe estar en el disco de Linux, no en /mnt/...: GDAL recibió
# bytes dañados al leer directamente del disco de Windows (ADR-0008).
# Opcional: si no se define, se usa ~/.cache/monitor-noticias/geodata del
# usuario de Ubuntu que corre el comando.
# GEODATA_WORK_DIR=/ruta/en/linux

# --- Pipeline de búsqueda (F4, docs/adr/0015) --------------------------------

# Segundos máximos para bajar la página de una nota y leer su texto.
# EXTRACTION_TIMEOUT_SECONDS=15
# Páginas que se leen a la vez en una búsqueda.
# EXTRACTION_CONCURRENCY=4
# Días que se conserva el texto extraído (solo sirve para procesar; nunca se
# muestra). La nota, su resumen y su ubicación se quedan.
# ARTICLE_TEXT_RETENTION_DAYS=30
# IA del enriquecimiento (docs/adr/0016): openai (por defecto) o gemini.
# LLM_PROVIDER=openai
# Llave de OpenAI (platform.openai.com). La pega Benji; sin la llave del
# proveedor elegido las notas no se enriquecen y la búsqueda lo avisa.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_PRICE_INPUT_PER_MILLION=0.10
# OPENAI_PRICE_OUTPUT_PER_MILLION=0.50
# Llave de Gemini (Google AI Studio). La pega Benji; sin ella las notas no se
# enriquecen con IA y la búsqueda lo avisa.
# GEMINI_API_KEY=
# Modelo de Gemini y sus precios por millón de tokens (para estimar el costo).
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_PRICE_INPUT_PER_MILLION=0.30
# GEMINI_PRICE_OUTPUT_PER_MILLION=2.50
# Segundos máximos por nota, notas a la vez y tope de notas por búsqueda.
# LLM_TIMEOUT_SECONDS=60
# LLM_CONCURRENCY=4
# LLM_MAX_ARTICLES_PER_SEARCH=150
# Confianza mínima (0 a 1) para que un lugar sea la ubicación principal.
# GEO_MIN_CONFIDENCE=0.6
